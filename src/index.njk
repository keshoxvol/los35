        <button type="submit" class="lead-form-submit" id="lf-submit">ОТПРАВИТЬ ЗАЯВКУ</button>
        <p class="lead-form-error" id="lf-error">Что-то пошло не так. Позвоните нам напрямую: {{ site.phoneDisplay }}</p>
      </form>
      <div class="lead-form-success" id="lf-success">
        ✓ Заявка принята!<br>
        <span style="font-family:var(--font-body);font-size:15px;color:var(--muted);font-weight:400;">Перезвоним вам в ближайшее время.</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <h2 class="cta-title">ГОТОВЫ ЗАКАЗАТЬ<br><span style="color:var(--amber)">СВОЙ ЛОСЬ?</span></h2>
    <p class="cta-desc">Позвоните — обсудим комплектацию, цвет, сроки. Цена фиксирована.</p>
    <div class="cta-actions">
      <a href="tel:{{ site.phone }}" class="btn-primary" style="font-size:15px;padding:20px 48px;">Позвонить сейчас</a>
      <a href="tel:{{ site.phone }}" class="cta-phone">{{ site.phoneDisplay }}</a>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="section-tag">Контакты</div>
    <h2 class="section-title">СВЯЖИТЕСЬ<br>С НАМИ</h2>
    <div class="contact-grid">
      <div class="contact-item">
        <div class="contact-label">Телефон</div>
        <a href="tel:{{ site.phone }}" class="contact-value">{{ site.phoneDisplay }}</a>
        <div style="margin-top:8px;font-size:12px;color:var(--muted);">Максим — руководитель производства</div>
      </div>
      <div class="contact-item">
        <div class="contact-label">Производство / Самовывоз</div>
        <span class="contact-value" style="font-size:18px;">{{ site.address }}</span>
        <div style="margin-top:8px;font-size:12px;color:var(--muted);">По предварительному согласованию</div>
      </div>
    </div>
  </section>
