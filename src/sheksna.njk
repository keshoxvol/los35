    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Лодка ЛОСЬ 400 — доставка в Шексну",
    "description": "Моторная лодка из ПНД-пластика для рыбалки на Шекснинском водохранилище. Доставка из Вологды в Шексну — 90 км.",
    "brand": { "@type": "Brand", "name": "ЛОСЬ 400" },
    "manufacturer": {
      "@type": "Organization",
      "name": "ООО «Вологодский Судостроительный Завод»",
      "telephone": "+78172263277",
      "address": { "@type": "PostalAddress", "addressLocality": "Вологда", "addressCountry": "RU" }
    },
    "offers": {
      "@type": "Offer",
      "price": "140000",
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "ООО «Вологодский Судостроительный Завод»" }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "2",
      "bestRating": "5"
    }
  }
pageCss:
  - /assets/css/model/hero.css
  - /assets/css/model/specs.css
  - /assets/css/model/kit.css
