    <div class="section-tag">Отзывы</div>
    <h2 class="section-title">ЧТО ГОВОРЯТ<br>ПОКУПАТЕЛИ</h2>
    <div class="why-grid">
      {% for review in reviews %}
      <div class="why-card">
        {% if review.image %}<img src="{{ review.image }}" alt="Фото лодки ЛОСЬ 400 — покупатель {{ review.name }}" style="width:100%;height:180px;object-fit:cover;border-radius:4px;margin-bottom:14px;">{% endif %}
        <div style="color:#f5a623;font-size:18px;letter-spacing:2px;margin-bottom:12px;">★★★★★</div>
        <p style="font-size:15px;line-height:1.7;margin-bottom:14px;">«{{ review.text }}»</p>
        <p style="font-size:13px;color:var(--muted);"><strong style="color:var(--light);">{{ review.name }}</strong> · {{ review.source }} · {{ review.date }}</p>
      </div>
      {% endfor %}
    </div>
    <p style="text-align:center;margin-top:24px;"><a href="/otzyvy/" style="color:var(--muted);font-size:14px;">Все отзывы →</a></p>
  </section>

  <!-- BLOG LINKS -->
  <section style="background: var(--dark);">
